{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"]
  },
  "include": ["playwright.config.ts", "pages/**/*.ts", "steps/**/*.ts", "fixtures/**/*.ts", "utils/**/*.ts", "tests/**/*.ts"]
}
