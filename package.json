{
  "name": "playwright-bdd-typescript-framework",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && playwright test --headed",
    "test:ui": "bddgen && playwright test --ui",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-gherkin": "^4.0.0",
    "typescript": "^5.9.2"
  }
}
